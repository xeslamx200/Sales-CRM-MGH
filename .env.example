# =====================================================================================================================
# CRM — LOCAL run against Supabase STAGING (crm-kapso-staging, ref oqwmgtayvsmbobwaunph). TEMPLATE ONLY: no secrets here.
#
# Create the real file next to this template as:   C:\Users\hp\crm-kapso-local-staging\.env.local
# (Next.js loads .env.local automatically from THIS directory; the original repository's .env.local is never used here.)
# Enter the values yourself on this machine. Never paste them into chat, tickets, logs or the repository.
# Never use Development or Production keys, and never copy anything from D:\crm-session1\.env.local.
# =====================================================================================================================

# ---- REQUIRED --------------------------------------------------------------------------------------------------------
# Supabase Staging project URL (fixed; must be exactly this value).
NEXT_PUBLIC_SUPABASE_URL=https://oqwmgtayvsmbobwaunph.supabase.co

# Staging "anon" (public) key. Supabase dashboard > crm-kapso-staging > Project Settings > API Keys.
# Prefer the legacy JWT "anon" key: it carries the project ref, so its project can be verified locally without a network call.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Staging "service_role" key (SERVER ONLY, full access, bypasses RLS). Same dashboard page. Prefer the legacy JWT key (see above).
SUPABASE_SERVICE_ROLE_KEY=

# Loopback origin of the local app (used for invite / password-reset links). The app will be bound to 127.0.0.1 only.
APP_URL=http://127.0.0.1:3000

# New random secret for the manual job triggers /api/cron/* (at least 32 bytes). Generate it locally (see the instructions).
CRON_SECRET=

# ---- MUST STAY UNSET (do not add these lines at all) -----------------------------------------------------------------
# WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN, WHATSAPP_ACCESS_TOKEN, WHATSAPP_GRAPH_API_VERSION   (no Meta; no Graph API sending)
# KAPSO_WEBHOOK_SECRET   (only after the Staging webhook is approved; the webhook answers 503 "not configured" meanwhile)
# KAPSO_PROTOCOL         (only after explicit approval to enable v2)
