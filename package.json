{
  "name": "crm-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:scratch": "node --test tests/scratch/*.test.ts",
    "test:db": "bash ./scripts/db/test.sh",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "seed:dev": "node --env-file=.env.local scripts/seed-dev.ts",
    "test:api": "node --env-file=.env.local --test --test-concurrency=1 tests/api/*.test.ts",
    "check:bundle": "node --env-file-if-exists=.env.local scripts/check-client-bundle.mjs",
    "check:migrations": "node scripts/db/check-migrations.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "shadcn": "4.22.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  }
}
